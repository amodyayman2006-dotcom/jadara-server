PORT=3000
NODE_ENV=production
# كلمة مرور المدير الأولية (تُطلب بتغييرها عند أول دخول). إن تُركت فارغة تُولَّد وتُطبع في السجل.
ADMIN_INITIAL_PASSWORD=
# 1 عند التشغيل خلف HTTPS (إلزامي في الإنتاج)
COOKIE_SECURE=1
# عند التشغيل خلف Nginx/Cloudflare
TRUST_PROXY=1
SITE_URL=https://magazine.example.edu.jo
DATA_DIR=./data
BACKUP_DIR=./backups
BACKUP_KEEP=14
# 0 لعدم تحميل المحتوى التجريبي عند أول تشغيل
SEED_DEMO=1
